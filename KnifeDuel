local function isMouseOverTarget()
    local mouse = LocalPlayer:GetMouse()
    local target = mouse.Target
    if target and target.Parent then
        local character = target.Parent
        local player = Players:GetPlayerFromCharacter(character)
        if player and player ~= LocalPlayer then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                return true
            end
        end
    end
    return false
end

table.insert(connections, RunService.RenderStepped:Connect(function()
    Camera.CameraType = Enum.CameraType.Custom

    -- Handle Player Modifiers (WalkSpeed, Fly, Noclip)
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local rootPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        
        if humanoid then
            if WalkSpeedEnabled then
                humanoid.WalkSpeed = WalkSpeedValue
            end
        end

        if NoclipEnabled then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        if FlyEnabled and rootPart then
            local moveDir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveDir = moveDir + Camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveDir = moveDir - Camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveDir = moveDir - Camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveDir = moveDir + Camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveDir = moveDir + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                moveDir = moveDir - Vector3.new(0, 1, 0)
            end

            rootPart.Velocity = moveDir * FlySpeed
            rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z))
        end
    end

    if FovEnabled then
        local mousePos = UserInputService:GetMouseLocation()
        FovCircle.Position = mousePos
        FovCircle.Visible = true
    else
        FovCircle.Visible = false
    end

    if AimbotEnabled then
        local target = getClosestPlayer()
        if target and target.Character then
            local targetPart = target.Character:FindFirstChild("Head") 
                or target.Character:FindFirstChild("UpperTorso") 
                or target.Character:FindFirstChild("HumanoidRootPart")
                or target.Character:FindFirstChild("Torso")
                
            if targetPart then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
                TargetLabel.Text = "Target: " .. target.Name
            else
                TargetLabel.Text = "Target: None"
            end
        else
            TargetLabel.Text = "Target: None"
        end
    else
        TargetLabel.Text = "Target: None"
    end

    if TriggerbotEnabled then
        if isMouseOverTarget() then
            local mouseLoc = UserInputService:GetMouseLocation()
            if TriggerbotMode == "Left" then
                VirtualInputManager:SendMouseButtonEvent(mouseLoc.X, mouseLoc.Y, 0, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(mouseLoc.X, mouseLoc.Y, 0, false, game, 0)
            else
                VirtualInputManager:SendMouseButtonEvent(mouseLoc.X, mouseLoc.Y, 1, true, game, 0)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(mouseLoc.X, mouseLoc.Y, 1, false, game, 0)
            end
        end
    end

    local activePlayers = {}
    
    local viewportSize = Camera.ViewportSize
    local tracerOrigin = Vector2.new(viewportSize.X / 2, viewportSize.Y)

    local currentBoxColor = BoxColor
    if RainbowBoxesEnabled then
        local hue = (tick() % 5) / 5
        currentBoxColor = Color3.fromHSV(hue, 1, 1)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
            
            if humanoid and humanoid.Health > 0 and rootPart then
                activePlayers[player] = true
                
                if not espDrawings[player] then
                    espDrawings[player] = {
                        Box = Drawing.new("Square"),
                        Tracer = Drawing.new("Line"),
                        NameTag = Drawing.new("Text"),
                        InfoTag = Drawing.new("Text"),
                        Hitboxes = {}
                    }
                    espDrawings[player].Box.Visible = false
                    espDrawings[player].Box.Thickness = 1.5
                    espDrawings[player].Box.Filled = false

                    espDrawings[player].Tracer.Visible = false
                    espDrawings[player].Tracer.Thickness = 1.5
                    espDrawings[player].Tracer.Color = Color3.fromRGB(255, 255, 255)

                    espDrawings[player].NameTag.Visible = false
                    espDrawings[player].NameTag.Size = 14
                    espDrawings[player].NameTag.Center = true
                    espDrawings[player].NameTag.Outline = true
                    espDrawings[player].NameTag.Color = Color3.fromRGB(255, 255, 255)

                    espDrawings[player].InfoTag.Visible = false
                    espDrawings[player].InfoTag.Size = 13
                    espDrawings[player].InfoTag.Center = true
                    espDrawings[player].InfoTag.Outline = true
                    espDrawings[player].InfoTag.Color = Color3.fromRGB(200, 200, 200)
                end

                local visuals = espDrawings[player]
                
                if EspHitboxesEnabled then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") and part.Transparency < 1 then
                            local hbKey = part
                            local highlightBox = visuals.Hitboxes[hbKey]
                            if not highlightBox then
                                highlightBox = Drawing.new("Square")
                                highlightBox.Thickness = 1
                                highlightBox.Filled = true
                                highlightBox.Transparency = 0.85
                                visuals.Hitboxes[hbKey] = highlightBox
                            end
                            
                            local cf, size = part.CFrame, part.Size
                            local screenPos, onScreen = Camera:WorldToViewportPoint(cf.Position)
                            if onScreen and screenPos.Z > 0 then
                                local topPoint = Camera:WorldToViewportPoint((cf * CFrame.new(0, size.Y / 2, 0)).Position)
                                local bottomPoint = Camera:WorldToViewportPoint((cf * CFrame.new(0, -size.Y / 2, 0)).Position)
                                local height = math.abs(topPoint.Y - bottomPoint.Y)
                                local width = height * (size.X / size.Y)
                                
                                highlightBox.Size = Vector2.new(math.max(width, 4), math.max(height, 4))
                                highlightBox.Position = Vector2.new(screenPos.X - highlightBox.Size.X / 2, screenPos.Y - highlightBox.Size.Y / 2)
                                highlightBox.Color = currentBoxColor
                                highlightBox.Visible = true
                            else
                                highlightBox.Visible = false
                            end
                        end
                    end
                else
                    for _, hb in pairs(visuals.Hitboxes) do
                        hb.Visible = false
                    end
                end

                local cf, size = character:GetBoundingBox()
                local screenPosition, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

                if onScreen and screenPosition.Z > 0 then
                    local topPoint = Camera:WorldToViewportPoint((cf + Vector3.new(0, size.Y / 2, 0)).Position)
                    local bottomPoint = Camera:WorldToViewportPoint((cf - Vector3.new(0, size.Y / 2, 0)).Position)
                    local boxHeight = math.abs(topPoint.Y - bottomPoint.Y)
                    local boxWidth = boxHeight / 2

                    if BoxButton then
                        if EspBoxesEnabled then
                            visuals.Box.Size = Vector2.new(boxWidth, boxHeight)
                            visuals.Box.Position = Vector2.new(screenPosition.X - boxWidth / 2, topPoint.Y)
                            visuals.Box.Color = currentBoxColor
                            visuals.Box.Visible = true
                        else
                            visuals.Box.Visible = false
                        end
                    end

                    if EspTracersEnabled then
                        visuals.Tracer.From = tracerOrigin
                        visuals.Tracer.To = Vector2.new(screenPosition.X, bottomPoint.Y)
                        visuals.Tracer.Visible = true
                    else
                        visuals.Tracer.Visible = false
                    end

                    if EspNamesEnabled then
                        visuals.NameTag.Text = player.Name
                        visuals.NameTag.Position = Vector2.new(screenPosition.X, topPoint.Y - 18)
                        visuals.NameTag.Visible = true
                    else
                        visuals.NameTag.Visible = false
                    end

                    local infoTextParts = {}
                    if EspHealthEnabled then
                        table.insert(infoTextParts, "HP: " .. math.floor(humanoid.Health))
                    end
                    if EspDistanceEnabled then
                        local distanceVal = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
                        table.insert(infoTextParts, distanceVal .. " studs")
                    end

                    if #infoTextParts > 0 then
                        visuals.InfoTag.Text = table.concat(infoTextParts, " | ")
                        visuals.InfoTag.Position = Vector2.new(screenPosition.X, bottomPoint.Y + 4)
                        visuals.InfoTag.Visible = true
                    else
                        visuals.InfoTag.Visible = false
                    end
                else
                    visuals.Box.Visible = false
                    visuals.Tracer.Visible = false
                    visuals.NameTag.Visible = false
                    visuals.InfoTag.Visible = false
                end
            else
                removeEspForPlayer(player)
            end
        end
    end

    for player, _ in pairs(espDrawings) do
        if not activePlayers[player] then
            removeEspForPlayer(player)
        end
    end
end))
