local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local mouseLocation = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local targetPart = player.Character:FindFirstChild("Head") 
                    or player.Character:FindFirstChild("UpperTorso") 
                    or player.Character:FindFirstChild("HumanoidRootPart")
                    or player.Character:FindFirstChild("Torso")
                    
                if targetPart then
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen and screenPoint.Z > 0 then
                        local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                        local distance = (screenPos2D - mouseLocation).Magnitude
                        if distance <= FovRadius and distance < shortestDistance then
                            shortestDistance = distance
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == ToggleKey then
            AimbotEnabled = not AimbotEnabled
            setAimbotUI(AimbotEnabled)
        elseif input.KeyCode == TeleportKey then
            if AimbotEnabled then
                setTpUI(true)
                local target = getClosestPlayer()
                if target and target.Character then
                    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

                    if targetRoot and myRoot then
                        local behindPos = targetRoot.Position - (targetRoot.CFrame.LookVector * 4)
                        myRoot.CFrame = CFrame.new(behindPos, targetRoot.Position)
                        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
                    end
                end
                task.delay(0.1, function() setTpUI(false) end)
            end
        end
    end
end))

local function isMouseOverTarget()
    local mouse = LocalPlayer:GetMouse()
    local target = mouse.Target
    if target and target.Parent then
        local character = target.Parent
        local player = Players:GetPlayerFromCharacter(character)
        if player and player ~= LocalPlayer then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then return true end
        end
    end
    return false
end

local function removeEspForPlayer(player)
    if espDrawings[player] then
        for _, drawing in pairs(espDrawings[player]) do
            if type(drawing) == "table" then
                for _, subDrawing in pairs(drawing) do
                    if subDrawing and subDrawing.Remove then subDrawing:Remove() end
                end
            elseif drawing and drawing.Remove then
                drawing:Remove()
            end
        end
        espDrawings[player] = nil
    end
end

table.insert(connections, RunService.RenderStepped:Connect(function()
    Camera.CameraType = Enum.CameraType.Custom

    if CustomFovEnabled then
        Camera.FieldOfView = CustomFovValue
    end

    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local rootPart = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        
        if humanoid and WalkSpeedEnabled then
            humanoid.WalkSpeed = WalkSpeedValue
        end

        if NoclipEnabled then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end

        if FlyEnabled and rootPart then
            local moveDir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

            rootPart.Velocity = moveDir * FlySpeed
            rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z))
        end
    end

    if FovEnabled then
        local mousePos = UserInputService:GetMouseLocation()
        FovCircle.Position = mousePos
        FovCircle.Visible = true
    else
        FovCircle.Visible = false
    end

    if AimbotEnabled then
        local target = getClosestPlayer()
        if target and target.Character then
            local targetPart = nil
            if AimbotTargetPart == "Head" then
                targetPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("UpperTorso")
            else
                targetPart = target.Character:FindFirstChild("UpperTorso") or target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Torso")
            end
                
            if targetPart then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
                TargetDisplay.Text = "Target: " .. target.Name
            else
                TargetDisplay.Text = "Target: None"
            end
        else
            TargetDisplay.Text = "Target: None"
        end
    end

    if TriggerbotEnabled and isMouseOverTarget() then
        local mouseLoc = UserInputService:GetMouseLocation()
        local btnInt = (TriggerbotMode == "Left") and 0 or 1
        VirtualInputManager:SendMouseButtonEvent(mouseLoc.X, mouseLoc.Y, btnInt, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(mouseLoc.X, mouseLoc.Y, btnInt, false, game, 0)
    end

    local activePlayers = {}
    local viewportSize = Camera.ViewportSize
    local tracerOrigin = Vector2.new(viewportSize.X / 2, viewportSize.Y)
    local currentBoxColor = BoxColor
    
    if RainbowBoxesEnabled then
        local hue = (tick() % 5) / 5
        currentBoxColor = Color3.fromHSV(hue, 1, 1)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
            
            if humanoid and humanoid.Health > 0 and rootPart then
                activePlayers[player] = true
                
                if not espDrawings[player] then
                    espDrawings[player] = {
                        Box = Drawing.new("Square"),
                        Tracer = Drawing.new("Line"),
                        NameTag = Drawing.new("Text"),
                        InfoTag = Drawing.new("Text"),
                        Hitboxes = {}
                    }
                    espDrawings[player].Box.Visible = false
                    espDrawings[player].Box.Thickness = 1.5
                    espDrawings[player].Box.Filled = false

                    espDrawings[player].Tracer.Visible = false
                    espDrawings[player].Tracer.Thickness = 1.5
                    espDrawings[player].Tracer.Color = Color3.fromRGB(255, 255, 255)

                    espDrawings[player].NameTag.Visible = false
                    espDrawings[player].NameTag.Size = 14
                    espDrawings[player].NameTag.Center = true
                    espDrawings[player].NameTag.Outline = true
                    espDrawings[player].NameTag.Color = Color3.fromRGB(255, 255, 255)

                    espDrawings[player].InfoTag.Visible = false
                    espDrawings[player].InfoTag.Size = 13
                    espDrawings[player].InfoTag.Center = true
                    espDrawings[player].InfoTag.Outline = true
                    espDrawings[player].InfoTag.Color = Color3.fromRGB(200, 200, 200)
                end

                local visuals = espDrawings[player]
                
                if EspHitboxesEnabled then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") and part.Transparency < 1 then
                            local hbKey = part
                            local highlightBox = visuals.Hitboxes[hbKey]
                            if not highlightBox then
                                highlightBox = Drawing.new("Square")
                                highlightBox.Thickness = 1
                                highlightBox.Filled = true
                                highlightBox.Transparency = 0.85
                                visuals.Hitboxes[hbKey] = highlightBox
                            end
                            
                            local cf, size = part.CFrame, part.Size
                            local screenPos, onScreen = Camera:WorldToViewportPoint(cf.Position)
                            if onScreen and screenPos.Z > 0 then
                                local topPoint = Camera:WorldToViewportPoint((cf * CFrame.new(0, size.Y / 2, 0)).Position)
                                local bottomPoint = Camera:WorldToViewportPoint((cf * CFrame.new(0, -size.Y / 2, 0)).Position)
                                local height = math.abs(topPoint.Y - bottomPoint.Y)
                                local width = height * (size.X / size.Y)
                                
                                highlightBox.Size = Vector2.new(math.max(width, 4), math.max(height, 4))
                                highlightBox.Position = Vector2.new(screenPos.X - highlightBox.Size.X / 2, screenPos.Y - highlightBox.Size.Y / 2)
                                highlightBox.Color = currentBoxColor
                                highlightBox.Visible = true
                            else
                                highlightBox.Visible = false
                            end
                        end
                    end
                else
                    for _, hb in pairs(visuals.Hitboxes) do hb.Visible = false end
                end

                local cf, size = character:GetBoundingBox()
                local screenPosition, onScreen = Camera:WorldToViewportPoint(rootPart.Position)

                if onScreen and screenPosition.Z > 0 then
                    local topPoint = Camera:WorldToViewportPoint((cf + Vector3.new(0, size.Y / 2, 0)).Position)
                    local bottomPoint = Camera:WorldToViewportPoint((cf - Vector3.new(0, size.Y / 2, 0)).Position)
                    local boxHeight = math.abs(topPoint.Y - bottomPoint.Y)
                    local boxWidth = boxHeight / 2

                    if EspBoxesEnabled then
                        visuals.Box.Size = Vector2.new(boxWidth, boxHeight)
                        visuals.Box.Position = Vector2.new(screenPosition.X - boxWidth / 2, topPoint.Y)
                        visuals.Box.Color = currentBoxColor
                        visuals.Box.Visible = true
                    else
                        visuals.Box.Visible = false
                    end

                    if EspTracersEnabled then
                        visuals.Tracer.From = tracerOrigin
                        visuals.Tracer.To = Vector2.new(screenPosition.X, bottomPoint.Y)
                        visuals.Tracer.Visible = true
                    else
                        visuals.Tracer.Visible = false
                    end

                    if EspNamesEnabled then
                        visuals.NameTag.Text = player.Name
                        visuals.NameTag.Position = Vector2.new(screenPosition.X, topPoint.Y - 18)
                        visuals.NameTag.Visible = true
                    else
                        visuals.NameTag.Visible = false
                    end

                    local infoTextParts = {}
                    if EspHealthEnabled then table.insert(infoTextParts, "HP: " .. math.floor(humanoid.Health)) end
                    if EspDistanceEnabled then
                        local distanceVal = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
                        table.insert(infoTextParts, distanceVal .. " studs")
                    end

                    if #infoTextParts > 0 then
                        visuals.InfoTag.Text = table.concat(infoTextParts, " | ")
                        visuals.InfoTag.Position = Vector2.new(screenPosition.X, bottomPoint.Y + 4)
                        visuals.InfoTag.Visible = true
                    else
                        visuals.InfoTag.Visible = false
                    end
                else
                    visuals.Box.Visible = false
                    visuals.Tracer.Visible = false
                    visuals.NameTag.Visible = false
                    visuals.InfoTag.Visible = false
                end
            else
                removeEspForPlayer(player)
            end
        end
    end

    for player, _ in pairs(espDrawings) do
        if not activePlayers[player] then removeEspForPlayer(player) end
    end
end))
