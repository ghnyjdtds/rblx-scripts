    box.Position = UDim2.new(0, 15, 0, 34)
    box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 13
    box.Font = Enum.Font.GothamMedium
    box.Text = "RGB " .. math.floor(defaultColor.R * 255) .. " " .. math.floor(defaultColor.G * 255) .. " " .. math.floor(defaultColor.B * 255)
    box.ClearTextOnFocus = false
    box.Parent = container

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = AccentColor
    boxStroke.Thickness = 1
    boxStroke.Transparency = 0.5
    boxStroke.Parent = box

    table.insert(connections, box.FocusLost:Connect(function(enterPressed)
        local r, g, b = box.Text:match("RGB%s*(%d+)%D+(%d+)%D+(%d+)")
        if not r then
            r, g, b = box.Text:match("(%d+)%D+(%d+)%D+(%d+)")
        end
        
        if r and g and b then
            local cr = math.clamp(tonumber(r), 0, 255)
            local cg = math.clamp(tonumber(g), 0, 255)
            local cb = math.clamp(tonumber(b), 0, 255)
            local newColor = Color3.fromRGB(cr, cg, cb)
            preview.BackgroundColor3 = newColor
            box.Text = "RGB " .. cr .. " " .. cg .. " " .. cb
            if callback then callback(newColor) end
        else
            local cur = preview.BackgroundColor3
            box.Text = "RGB " .. math.floor(cur.R * 255) .. " " .. math.floor(cur.G * 255) .. " " .. math.floor(cur.B * 255)
        end
    end))
end

