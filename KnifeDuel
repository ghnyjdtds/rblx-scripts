local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local mouseLocation = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local targetPart = player.Character:FindFirstChild("Head") 
                    or player.Character:FindFirstChild("UpperTorso") 
                    or player.Character:FindFirstChild("HumanoidRootPart")
                    or player.Character:FindFirstChild("Torso")
                    
                if targetPart then
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    
                    if onScreen and screenPoint.Z > 0 then
                        local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
                        local distance = (screenPos2D - mouseLocation).Magnitude

                        if distance <= FovRadius and distance < shortestDistance then
                            shortestDistance = distance
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

