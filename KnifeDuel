-- Keybinds for Aimbot (E) and Teleport / Face (G)
table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == ToggleKey then
            updateAimbotState()
        elseif input.KeyCode == TeleportKey then
            if AimbotEnabled then
                -- Turn ON / Turn Green automatically on press
                TeleportBehindEnabled = true
                TeleportBehindButton.Text = "Teleport Behind (G): ON"
                TeleportBehindButton.TextColor3 = Color3.fromRGB(100, 255, 100)

                local target = getClosestPlayer()
                if target and target.Character then
                    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

                    if targetRoot and myRoot then
                        -- 1. TELEPORT 4 studs behind the target facing towards them
                        local behindPos = targetRoot.Position - (targetRoot.CFrame.LookVector * 4)
                        myRoot.CFrame = CFrame.new(behindPos, targetRoot.Position)
                        
                        -- 2. FORCE CAMERA to face the player even in first person
                        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetRoot.Position)
                    end
                end

                -- Instantly turn OFF / turn Red so it's ready for the next press
                task.delay(0.05, function()
                    TeleportBehindEnabled = false
                    TeleportBehindButton.Text = "Teleport Behind (G): OFF"
                    TeleportBehindButton.TextColor3 = Color3.fromRGB(255, 100, 100)
                end)
            end
        end
    end
end))

