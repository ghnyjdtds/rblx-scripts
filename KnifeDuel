local function createTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.85, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamMedium
    btn.Text = name
    btn.AutoButtonColor = false
    btn.Parent = TabContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local panel = Instance.new("ScrollingFrame")
    panel.Size = UDim2.new(1, -30, 1, -30)
    panel.Position = UDim2.new(0, 15, 0, 15)
    panel.BackgroundTransparency = 1
    panel.ScrollBarThickness = 4
    panel.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60)
    panel.Visible = false
    panel.Parent = ContentArea

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 12)
    layout.Parent = panel
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        panel.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    btn.MouseButton1Click:Connect(function()
        if activeTab then
            activeTab.btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            activeTab.btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            activeTab.panel.Visible = false
            if activeTabStroke then activeTabStroke:Destroy() end
        end
        
        activeTab = {btn = btn, panel = panel}
        btn.BackgroundColor3 = AccentColor
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        panel.Visible = true

        activeTabStroke = Instance.new("UIStroke")
        activeTabStroke.Color = AccentColor
        activeTabStroke.Thickness = 1.5
        activeTabStroke.Transparency = 0.2
        activeTabStroke.Parent = btn
    end)

    table.insert(tabs, btn)
    table.insert(panels, panel)

    if #tabs == 1 then
        activeTab = {btn = btn, panel = panel}
        btn.BackgroundColor3 = AccentColor
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        panel.Visible = true
        
        activeTabStroke = Instance.new("UIStroke")
        activeTabStroke.Color = AccentColor
        activeTabStroke.Thickness = 1.5
        activeTabStroke.Transparency = 0.2
        activeTabStroke.Parent = btn
    end

    return panel
end

local function createToggle(parent, text, defaultState, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 36)
    container.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
    container.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = container

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -70, 1, 0)
    label.Position = UDim2.new(0, 15, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.Parent = container

    local toggleBg = Instance.new("TextButton")
    toggleBg.Size = UDim2.new(0, 46, 0, 24)
    toggleBg.Position = UDim2.new(1, -60, 0.5, -12)
    toggleBg.BackgroundColor3 = defaultState and AccentColor or Color3.fromRGB(70, 70, 70)
    toggleBg.Text = ""
    toggleBg.AutoButtonColor = false
    toggleBg.Parent = container

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggleBg
    
    local toggleGlow = Instance.new("UIStroke")
    toggleGlow.Color = AccentColor
    toggleGlow.Thickness = 1
    toggleGlow.Transparency = defaultState and 0 or 1
    toggleGlow.Parent = toggleBg

    local toggleCircle = Instance.new("Frame")
    toggleCircle.Size = UDim2.new(0, 20, 0, 20)
    toggleCircle.Position = defaultState and UDim2.new(1, -22, 0, 2) or UDim2.new(0, 2, 0, 2)
    toggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleCircle.Parent = toggleBg

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = toggleCircle

    local state = defaultState

    local function updateVisuals(newState)
        state = newState
        local targetColor = state and AccentColor or Color3.fromRGB(70, 70, 70)
        local targetPos = state and UDim2.new(1, -22, 0, 2) or UDim2.new(0, 2, 0, 2)
        local targetGlow = state and 0 or 1
        
        TweenService:Create(toggleBg, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(toggleCircle, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = targetPos}):Play()
        TweenService:Create(toggleGlow, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Transparency = targetGlow}):Play()
    end

    table.insert(connections, toggleBg.MouseButton1Click:Connect(function()
        local newState = not state
        updateVisuals(newState)
        if callback then callback(newState) end
    end))

    return function(overrideState)
        updateVisuals(overrideState)
        if callback then callback(overrideState) end
    end
end

