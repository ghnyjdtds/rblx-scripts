    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0, 50, 0, 26)
    valLabel.Position = UDim2.new(1, -60, 0, 4)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(defaultVal)
    valLabel.TextColor3 = AccentColor
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.Font = UI_Font
    valLabel.TextSize = 12
    valLabel.Parent = container

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -32, 0, 8)
    bar.Position = UDim2.new(0, 16, 0, 36)
    bar.BackgroundColor3 = Color3.fromRGB(40, 48, 65)
    bar.BackgroundTransparency = 0.3
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = container

    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(1, 0)
    barCorner.Parent = bar

    local fill = Instance.new("Frame")
    local initialFill = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
    fill.Size = UDim2.new(initialFill, 0, 1, 0)
    fill.BackgroundColor3 = AccentColor
    fill.Parent = bar

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill

    local draggingBar = false
    table.insert(connections, bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingBar = true
        end
    end))

    table.insert(connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingBar = false
        end
    end))

    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if draggingBar and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mousePos = UserInputService:GetMouseLocation()
            local relativeX = math.clamp(mousePos.X - bar.AbsolutePosition.X, 0, bar.AbsoluteSize.X)
            local percentage = relativeX / bar.AbsoluteSize.X
            
            local val = math.floor(minVal + (percentage * (maxVal - minVal)))
            fill.Size = UDim2.new(percentage, 0, 1, 0)
            valLabel.Text = tostring(val)
            if callback then callback(val) end
        end
    end))
end

