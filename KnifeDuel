local function createTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.86, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(30, 35, 48)
    btn.BackgroundTransparency = 0.5
    btn.TextColor3 = Color3.fromRGB(150, 160, 185)
    btn.TextSize = 13
    btn.Font = UI_Font
    btn.Text = name
    btn.AutoButtonColor = false
    btn.Parent = TabContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 14)
    corner.Parent = btn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(70, 80, 110)
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.6
    btnStroke.Parent = btn

    local panel = Instance.new("ScrollingFrame")
    panel.Size = UDim2.new(1, -24, 1, -24)
    panel.Position = UDim2.new(0, 12, 0, 12)
    panel.BackgroundTransparency = 1
    panel.ScrollBarThickness = 3
    panel.ScrollBarImageColor3 = Color3.fromRGB(80, 90, 120)
    panel.Visible = false
    panel.Parent = ContentArea

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 12)
    layout.Parent = panel
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        panel.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    btn.MouseButton1Click:Connect(function()
        playClickSound()
        if activeTab then
            activeTab.btn.BackgroundColor3 = Color3.fromRGB(30, 35, 48)
            activeTab.btn.BackgroundTransparency = 0.5
            activeTab.btn.TextColor3 = Color3.fromRGB(150, 160, 185)
            activeTab.panel.Visible = false
        end
        
        activeTab = {btn = btn, panel = panel}
        btn.BackgroundColor3 = AccentColor
        btn.BackgroundTransparency = 0.15
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        panel.Visible = true
    end)

    table.insert(tabs, btn)
    table.insert(panels, panel)

    if #tabs == 1 then
        activeTab = {btn = btn, panel = panel}
        btn.BackgroundColor3 = AccentColor
        btn.BackgroundTransparency = 0.15
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        panel.Visible = true
    end

    return panel
end

local function createToggle(parent, text, defaultState, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 42)
    container.BackgroundColor3 = Color3.fromRGB(25, 29, 40)
    container.BackgroundTransparency = 0.5
    container.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 16)
    corner.Parent = container

    local containerStroke = Instance.new("UIStroke")
    containerStroke.Color = Color3.fromRGB(60, 70, 95)
    containerStroke.Thickness = 1
    containerStroke.Transparency = 0.6
    containerStroke.Parent = container

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -85, 1, 0)
    label.Position = UDim2.new(0, 16, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(215, 222, 240)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = UI_Font
    label.TextSize = 12
    label.Parent = container

    local toggleBg = Instance.new("TextButton")
    toggleBg.Size = UDim2.new(0, 56, 0, 28)
    toggleBg.Position = UDim2.new(1, -68, 0.5, -14)
    toggleBg.BackgroundColor3 = defaultState and AccentColor or Color3.fromRGB(35, 41, 56)
    toggleBg.BackgroundTransparency = defaultState and 0.15 or 0.4
    toggleBg.Text = defaultState and "ON" or "OFF"
    toggleBg.TextColor3 = defaultState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 150, 175)
    toggleBg.TextSize = 10
    toggleBg.Font = UI_Font
    toggleBg.AutoButtonColor = false
    toggleBg.Parent = container

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggleBg

    local toggleStroke = Instance.new("UIStroke")
    toggleStroke.Color = defaultState and AccentColor or Color3.fromRGB(70, 80, 110)
    toggleStroke.Thickness = 1
    toggleStroke.Transparency = 0.4
    toggleStroke.Parent = toggleBg

    local state = defaultState

    local function updateVisuals(newState)
        state = newState
        local targetColor = state and AccentColor or Color3.fromRGB(35, 41, 56)
        local targetTransparency = state and 0.15 or 0.4
        local targetText = state and "ON" or "OFF"
        local targetTextColor = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 150, 175)
        
        TweenService:Create(toggleBg, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundColor3 = targetColor, BackgroundTransparency = targetTransparency}):Play()
        toggleBg.Text = targetText
        toggleBg.TextColor3 = targetTextColor
    end

    table.insert(connections, toggleBg.MouseButton1Click:Connect(function()
        playClickSound()
        local newState = not state
        updateVisuals(newState)
        if callback then callback(newState) end
    end))

    return function(overrideState)
        updateVisuals(overrideState)
        if callback then callback(overrideState) end
    end
end

